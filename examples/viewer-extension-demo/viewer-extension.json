          "items": [
            { "label": "Voluntary", "column": "voluntary_delta", "unit": "switches" },
            { "label": "Time", "column": "start_ns", "unit": "timestamp" }
          ]
        },
        {
          "name": "tooltip/v1",
          "table": "context_switches",
          "match": {
            "start": "start_ns",
            "end": "end_ns",
            "y": "involuntary_delta"
          },
          "items": [
            { "label": "Involuntary", "column": "involuntary_delta", "unit": "switches" },
            { "label": "Time", "column": "start_ns", "unit": "timestamp" }
          ]
        },
        {
          "name": "readout/v1",
          "table": "context_switches",
          "items": [
            { "label": "voluntary max", "column": "voluntary_delta", "reduce": "max", "unit": "switches" },
            { "label": "involuntary max", "column": "involuntary_delta", "reduce": "max", "unit": "switches" }
          ]
        }
      ]
    },
